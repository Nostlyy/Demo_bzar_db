<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="13.0" styleClass="page" stylesheets="@style.css" fx:controller="pe.edu.upeu.project_final_gp1.controller.ProductoController">
  <padding>
    <Insets top="20.0" right="22.0" bottom="20.0" left="22.0"/>
  </padding>
  <children>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
      <children>
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
          <children>
            <Label text="Inventario de productos" styleClass="page-title"/>
            <Label text="Organiza el catálogo, los precios y las existencias de tu tienda." styleClass="page-subtitle"/>
          </children>
        </VBox>
        <Label text="CONTROL DE STOCK" styleClass="hero-chip"/>
      </children>
    </HBox>
    <VBox spacing="10.0" styleClass="section-card">
      <children>
        <Label text="Datos del artículo" styleClass="section-heading"/>
        <GridPane hgap="12.0" vgap="7.0">
          <columnConstraints>
            <ColumnConstraints minWidth="72.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
            <ColumnConstraints minWidth="60.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
          </columnConstraints>
          <children>
            <Label text="Código / ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtId" promptText="Ej. PROD-001" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Label text="Precio (S/):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Stock:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtStock" promptText="0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
          </children>
        </GridPane>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
          <children>
            <Button text="+ Registrar producto" onAction="#handleRegistrar" styleClass="button-login"/>
            <Button text="Actualizar" onAction="#handleActualizar" styleClass="button-action-edit"/>
            <Button text="Eliminar" onAction="#handleEliminar" styleClass="button-action-delete"/>
            <Button text="Limpiar" onAction="#handleLimpiar" styleClass="button-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="Buscar por código o nombre..." onAction="#handleBuscar" prefWidth="260.0"/>
          </children>
        </HBox>
      </children>
    </VBox>
    <VBox spacing="8.0" styleClass="section-card" VBox.vgrow="ALWAYS">
      <children>
        <HBox alignment="CENTER_LEFT">
          <children>
            <Label text="Catálogo de productos" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Selecciona un registro para editarlo" styleClass="muted-label"/>
          </children>
        </HBox>
        <TableView fx:id="tableProductos" minHeight="220.0" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colId" text="Código" prefWidth="130.0"/>
            <TableColumn fx:id="colNombre" text="Producto" prefWidth="300.0"/>
            <TableColumn fx:id="colPrecio" text="Precio (S/)" prefWidth="120.0"/>
            <TableColumn fx:id="colStock" text="Stock disponible" prefWidth="140.0"/>
          </columns>
          <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
          </columnResizePolicy>
        </TableView>
      </children>
    </VBox>
  </children>
</VBox>
